{
  "name": "koji-devis-gratuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Générateur de devis gratuit par IA (projet autonome, séparé de koji-web)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "ci": "npm run lint && npm run test:unit && npm run build && npm run test:integration"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6"
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
