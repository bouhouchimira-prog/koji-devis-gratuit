# Copiez ce fichier en .env.local et remplissez les valeurs.

# --- Devis gratuit ---
# Interrupteur : tant que ce n'est pas "true", les pages et les routes répondent 404.
DEVIS_GRATUIT_ENABLED=true
# Assistant hors ligne pour tester l'interface sans appeler Claude.
DEVIS_GRATUIT_DEMO=false
# Modèle Claude du chat (petit modèle = faible coût par devis).
DEVIS_GRATUIT_MODEL=claude-haiku-5-5
# Signe le cookie de session et sale l'empreinte des IP. 32 caractères au moins.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVIS_GRATUIT_SECRET=
# Quotas (valeurs de départ).
DEVIS_GRATUIT_SESSIONS_PER_IP=5
DEVIS_GRATUIT_MESSAGES_PER_SESSION=30

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Supabase (sinon stockage local dans .data/) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (sinon pas de copie par email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Koji <devis@getkoji.io>

# --- Liens publics ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KOJI_PRO_URL=https://getkoji.io
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
